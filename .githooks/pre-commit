#!/usr/bin/env bash
# Runs before every commit (terminal or GitHub Desktop). Blocks anything that
# must never reach the public repo. Turn on once per clone with scripts/setup.sh.
set -euo pipefail

# GitHub Desktop runs hooks without your shell's PATH, so add Homebrew's.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
cd "$(git rev-parse --show-toplevel)"

# 1. Build output never belongs in the repo.
if git diff --cached --name-only --diff-filter=ACMR | grep -Eq '^(dist|target)/'; then
  echo "BLOCK  dist/ or target/ is staged; that's build output, unstage it"
  exit 1
fi

# 2. Unpublished notes and image metadata.
scripts/guard.sh --staged

# 3. Secrets (API keys, tokens, passwords).
if ! command -v gitleaks >/dev/null; then
  echo "BLOCK  gitleaks not installed; cannot check for secrets (brew install gitleaks)"
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --log-level warn
